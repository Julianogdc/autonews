# Modelo de variáveis do Autonews.
# Copie para ".env" no servidor e preencha. NUNCA versione o ".env" real.

# Banco próprio do Autonews (valores reais ficam só no servidor).
DATABASE_URL=postgresql://autonews:SENHA_AQUI@autonews-postgres:5432/autonews?schema=public

# Chave de sessão do painel (gere com: openssl rand -hex 32)
SESSION_SECRET=GERAR_NO_SERVIDOR

# Chave da API de IA (preencher quando o provedor for escolhido)
AI_API_KEY=
