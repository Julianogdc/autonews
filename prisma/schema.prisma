// Schema inicial do Autonews (Fase 1).
// Tabelas de pautas, fatos, alertas e rascunhos entram nas fases 4 a 6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Portais monitorados (fase 2 usa estes registros).
model Source {
  id        String   @id @default(cuid())
  key       String   @unique // ex.: "campograndenews"
  name      String
  baseUrl   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Registro de auditoria: quem fez o quê e quando.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Matéria detectada em um portal. A URL é única: a mesma matéria nunca entra duas vezes.
model Article {
  id          String    @id @default(cuid())
  sourceKey   String    // ex.: "campograndenews"
  url         String    @unique
  title       String
  publishedAt DateTime?
  author      String?
  category    String?
  imageUrl    String?   // só referência; a imagem nunca é armazenada
  imageCredit String?
  text        String?   // texto extraído; apagado após 30 dias (textPurgeAt)
  textPurgeAt DateTime?
  detectedAt  DateTime  @default(now())
  status      String    @default("NOVA")
  // Triagem (fase 3): nota 0-100, prioridade e motivos. Preenchida pelo worker.
  score       Int?
  priority    String?   // URGENTE | ALTA | NORMAL | BAIXA
  reasons     String[]  @default([])
  triagedAt   DateTime?
  // Agrupamento (fase 4): matérias do mesmo fato apontam para a mesma pauta.
  storyId     String?
  story       Story?    @relation(fields: [storyId], references: [id])
  // Fatos (fase 5): números extraídos do texto. factsAt marca que a extração já rodou.
  factsAt     DateTime?
  facts       Fact[]
}

// Pauta: um fato coberto por um ou mais portais.
model Story {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
  alerts    Alert[]
  drafts    Draft[]
}

// Rascunho de matéria gerado por IA (fase 6). A equipe revisa e publica manualmente.
model Draft {
  id              String   @id @default(cuid())
  storyId         String
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title           String
  subtitle        String?
  body            String
  category        String?
  tags            String[] @default([])
  seoTitle        String?
  seoDescription  String?
  sources         Json     // [{ sourceKey, title, url }]
  reviewFlags     String[] @default([]) // ex.: DIVERGENCIA, TEMA_SENSIVEL
  unsupported     String[] @default([]) // afirmações não encontradas nas fontes (conferência)
  checks          Json?    // checagem com pesquisa na web: { items: [{ claim, status, note, urls }], web: [{ url, title }] }
  model           String
  status          String   @default("GERADO") // GERADO | PUBLICADA | IGNORADA
  createdAt       DateTime @default(now())

  @@index([storyId])
}

// Número extraído de uma matéria (valor em R$, percentual, quantidade, velocidade, horário).
model Fact {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  kind      String
  value     String
  raw       String
  createdAt DateTime @default(now())

  @@index([articleId])
}

// Alerta de uma pauta (ex.: divergência de números entre portais). Rastreável até as fontes.
model Alert {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  kind      String   // ex.: DIVERGENCIA
  detail    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([storyId])
}

// Conversas do chat de IA (uso interno). Cada conversa pertence a um usuário.
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user | assistant
  content        String
  model          String?
  sources        Json?        // [{ url, title }] quando a resposta usou pesquisa na web
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
